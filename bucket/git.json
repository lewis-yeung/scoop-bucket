{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.56.0-2",
    "description": "The Windows port of Git, a free and open source distributed version control system.",
    "homepage": "https://gitforwindows.org/",
    "license": {
        "identifier": "GPL-2.0-only",
        "url": "https://github.com/git-for-windows/git/blob/main/COPYING"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/PortableGit-2.56.0.2-64-bit.7z.exe#/dl.7z",
            "hash": "075e158ef8e1f0ab80b347e245405d3eca735c2dc88fd8e032e137d0ca61f61b"
        },
        "arm64": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/PortableGit-2.56.0.2-arm64.7z.exe#/dl.7z",
            "hash": "0f21e681bd33e006e0348dfa1a2be6769efd77e3bfdb247320314facde23a46c"
        }
    },
    "post_install": "& \"$dir\\bin\\bash.exe\" -c 'cmd //c /post-install.bat' *>$null",
    "env_add_path": "bin",
    "persist": [
        "etc\\fstab",
        "etc\\gitconfig"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/git-for-windows/git/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "(?<tag>v(?<version>[\\d.]+)\\.windows\\.(?<build>[\\d]+))",
        "replace": "${version}-${build}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/git-for-windows/git/releases/download/$matchTag/PortableGit-$matchVersion.$matchBuild-64-bit.7z.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/git-for-windows/git/releases/download/$matchTag/PortableGit-$matchVersion.$matchBuild-arm64.7z.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://github.com/git-for-windows/git/releases/tag/$matchTag",
            "regex": "(?s)$basename.*?$sha256"
        }
    }
}
